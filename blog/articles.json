---
layout: null
permalink: /blog/articles.json
sitemap: false
---
{% include blog_articles.html %}
[
{% for article in all_articles %}
  {
    "title": {{ article.title | jsonify }},
    "date": {{ article.date | date: "%Y-%m-%d" | jsonify }},
    "url": {{ article.url | relative_url | jsonify }},
    "source": {{ article.path | jsonify }},
    "description": {{ article.description | default: "" | jsonify }},
    "image": {{ article.image | default: "" | jsonify }},
    "tags": {{ article.tags | default: empty | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
